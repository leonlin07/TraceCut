# Required for the default planner
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3.5-35B-A3B

# Optional independent reviewer / failover model gateway.
# Leave VENUS_BASE_URL empty to disable it (the pipeline then falls back to
# SiliconFlow + deterministic audit only); set it only if you operate your own
# OpenAI-compatible gateway.
VENUS_API_KEY=
VENUS_BASE_URL=
VENUS_MODEL=Qwen/Qwen3.5-35B-A3B

# Licensed stock-video source
PEXELS_API_KEY=

# Optional web search for active per-claim evidence retrieval (rumor judgment).
# Leave empty to fall back to Wikipedia-only search. Free tier: brave.com/search/api
BRAVE_API_KEY=
BRAVE_BASE_URL=https://api.search.brave.com

# Optional local behavior
TRACECUT_OUTPUT_DIR=runs
# TTS backend: "cosyvoice" (SiliconFlow CosyVoice2 API, default, no GPU) or "say" (macOS).
TRACECUT_TTS=cosyvoice
TRACECUT_TTS_VOICE=Tingting
# CosyVoice2 preset voice (alex/anna/bella/benjamin/charles/claire/david/diana).
TRACECUT_COSYVOICE_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex
# Optional emotion/prosody instruction prepended before <|endofprompt|> (e.g. "用沉稳清晰的科普语气").
TRACECUT_TTS_INSTRUCTION=
# Some public APIs require an identifiable contact-bearing User-Agent.
TRACECUT_USER_AGENT=TraceCut/0.1 your-contact@example.com
